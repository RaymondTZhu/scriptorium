# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Generated project data
data/raw/*
data/processed/*
data/glyphs/*
data/outputs/*
data/manifests/*
experiments/results/*

# Retain the documented directory layout
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/glyphs/.gitkeep
!data/outputs/.gitkeep
!data/manifests/.gitkeep
!experiments/results/.gitkeep
